# Ignore everything except skills, memory, and sync scripts
*
/*/
!.gitignore
!sync.sh
!setup-device.sh
!skills/
!memory/

# Shared knowledge sync (WorkBuddy ↔ Claw)
!shared-knowledge/
shared-knowledge/*
!shared-knowledge/incoming/
!shared-knowledge/lessons/
!shared-knowledge/*.md

# Ignore skill dependencies (large binary/node_modules)
skills/*/node_modules/
skills/*/.git/
skills/*/*.exe
skills/*/*.dll
skills/*/__pycache__/

# Ignore misc
*.zip
*.tar.gz
.DS_Store
